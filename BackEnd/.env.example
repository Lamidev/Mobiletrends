PORT=8050
NODE_ENV=production
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mobiletrends?retryWrites=true&w=majority
JWT_SECRET=your_super_secure_jwt_secret_key

# Frontend URLs for CORS and email callbacks
CLIENT_URL=https://mobiletrends.ng
FRONTEND_URL=https://mobiletrends.ng

# Resend Email Configuration
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
SENDER_EMAIL=noreply@mobiletrends.ng
SENDER_NAME="Mobiletrends Systems Limited"
ADMIN_EMAIL=Admin@mobiletrends.ng

# Cloudinary (Product & Feature Banner Images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
