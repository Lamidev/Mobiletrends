PORT=8050
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mobiletrends
JWT_SECRET=your_strong_jwt_secret

# Frontend URL (used for CORS and email links)
FRONTEND_URL=https://mobiletrends.ng
CLIENT_BASE_URL=https://mobiletrends.ng

# Resend Email Configuration
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
SENDER_EMAIL=noreply@mobiletrends.ng
SENDER_NAME=Mobiletrends Systems Limited
ADMIN_EMAIL=Admin@mobiletrends.ng

# Cloudinary (Product & Feature Banner Images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paystack
PAYSTACK_SECRET_KEY=your_paystack_secret_key

